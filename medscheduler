DESCRIBE paciente;
DESCRIBE medico;
DESCRIBE consulta;

SELECT 
    p.nome AS Nome_Paciente,
    CONCAT(SUBSTRING(p.cpf, 1, 5), '...') AS CPF,
    m.nome AS Nome_Medico,
    c.data_consulta AS Data_Consulta,
    CASE 
        WHEN pr.diagnostico_cid IS NOT NULL AND pr.diagnostico_cid != '' THEN 'Acompanhamento'
        ELSE 'Livre'
    END AS status_saude
FROM consulta c
INNER JOIN paciente p ON c.id_paciente = p.id_paciente
INNER JOIN medico m ON c.id_medico = m.id_medico
LEFT JOIN prontuario pr ON c.id_consulta = pr.id_consulta;
