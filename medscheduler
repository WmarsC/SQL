USE medscheduler_db;

CREATE TABLE IF NOT EXISTS prontuario (
    id_prontuario INT AUTO_INCREMENT PRIMARY KEY,
    id_consulta INT NOT NULL,
    data_registro DATETIME NOT NULL,
    descricao_sintomas TEXT NOT NULL,
    diagnostico_cid VARCHAR(50) NOT NULL,
    FOREIGN KEY (id_consulta) REFERENCES consulta(id_consulta)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS prescricao (
    id_prescricao INT AUTO_INCREMENT PRIMARY KEY,
    id_prontuario INT NOT NULL,
    medicamento VARCHAR(100) NOT NULL,
    dosagem VARCHAR(50) NOT NULL,
    instrucoes TEXT NOT NULL,
    FOREIGN KEY (id_prontuario) REFERENCES prontuario(id_prontuario)
        ON DELETE CASCADE ON UPDATE CASCADE
);

CREATE TABLE IF NOT EXISTS log_acesso_sensivel (
    id_log INT AUTO_INCREMENT PRIMARY KEY,
    id_usuario INT NOT NULL,
    tabela_acessada VARCHAR(100) NOT NULL,
    data_hora_acesso DATETIME DEFAULT CURRENT_TIMESTAMP
);

